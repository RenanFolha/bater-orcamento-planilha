__pycache__/
*.pyc
*.pyo
*.log
.venv/

# Artefato local do pytest-cov (ver `pytest --cov`) -- não é dependência
# do projeto, só uma ferramenta de diagnóstico instalada sob demanda.
.coverage

# Banco de dados local — contém hashes de senha, sessões e histórico de
# clientes; nunca deve ser versionado. Cada ambiente cria o seu próprio
# na primeira execução (ver frete_db.py / README.md).
frete.db
frete.db-journal
frete.db-wal
frete.db-shm

# Config de conexão com o banco (pode ter host/usuário de um servidor
# SQL Server/MySQL/PostgreSQL externo; a senha é gravada cifrada — ver
# db_conexao.py) e a chave local usada pra cifrar/decifrar essa senha.
db_config.json
db_config.key

.idea/
.vscode/

# Certificado TLS autoassinado (chave privada nunca deve ser versionada —
# gerado localmente, cada ambiente cria o seu próprio; ver README.md).
certs/
